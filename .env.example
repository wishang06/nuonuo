OPENAI_API_KEY=sk-your-key-here
NUONUO_MODEL=gpt-live-1
NUONUO_BACKEND_MODEL=gpt-6-luna
NUONUO_SUMMARY_MODEL=gpt-6-luna
VISION_ENABLED=true
USER_NAME=Andy
NUONUO_VOICE=maple

# Voice session gate. A voice session opens only after your face has been in view for
# WAKE_SECONDS (with the camera off, about half a second of speech wakes her instead).
WAKE_SECONDS=1.5
# Close the session after this many minutes with no face and no speech.
IDLE_TIMEOUT_MIN=3
# Hard cap on one live session, in minutes. At the cap she closes and reopens with a recap.
SESSION_CAP_MIN=40
# Voice minutes per day, kept in data/voice_usage.json across restarts. 0 turns a cap off.
DAILY_CAP_MIN=120
